	emojiLbl.Font = Enum.Font.GothamBlack
	emojiLbl.TextColor3 = C_MINT
	emojiLbl.ZIndex = 10
	emojiLbl.Parent = emojiBox

	local lbl = Instance.new("TextLabel")
	lbl.BackgroundTransparency = 1
	lbl.Text = labelText
	lbl.TextSize = 12
	lbl.TextColor3 = C_MID
	lbl.Font = Enum.Font.GothamBold
